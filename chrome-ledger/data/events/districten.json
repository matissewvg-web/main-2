[
  {
    "id": "ev_havenstaking",
    "titel": "Havenstaking",
    "tekst": "De dokwerkers in {district} leggen het werk neer. Containers stapelen zich op en jouw naam staat op de spandoeken.",
    "toon": ["grimmig", "serieus"],
    "van": 2002, "tot": 2077,
    "cooldown": 16,
    "voorwaarde": [{ "district_type": "Haven", "controle": true }],
    "keuzes": [
      {
        "tekst": "Betaal de vakbond (€8.000)",
        "vereist": [{ "stat": "geld", "min": 8000 }],
        "effecten": [
          { "stat": "geld", "op": "add", "waarde": -8000 },
          { "district": "Haven", "stat": "loyaliteit", "op": "add", "waarde": 10 }
        ],
        "resultaat": "De kranen draaien weer. De vakbondsleider schudt je hand en noemt je 'een redelijke man'."
      },
      {
        "tekst": "Stuur beveiliging",
        "effecten": [
          { "stat": "heat", "op": "add", "waarde": 8 },
          { "district": "Haven", "stat": "loyaliteit", "op": "add", "waarde": -15 }
        ],
        "resultaat": "Je mensen jagen de piketten weg. Er vallen gewonden, en er staan camera's.",
        "volgt": "ev_havenstaking_escalatie"
      },
      {
        "tekst": "Laat het uitzieken",
        "effecten": [{ "district": "Haven", "stat": "invloed", "op": "add", "waarde": -8 }],
        "resultaat": "Na drie weken gaan ze terug aan het werk. Maar ze werken nu liever voor iemand anders."
      }
    ]
  },
  {
